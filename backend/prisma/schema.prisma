datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Candidate {
  id                      String       @id @default(uuid())
  studentId               String       @unique
  name                    String
  program                 String
  paymentStatus           String
  normalizedPaymentStatus String       // PAID, NOT_PAID, PARTIALLY_PAID
  eligibilityStatus       Boolean      @default(false)
  registrationStatus      String       @default("NOT_REGISTERED") // NOT_REGISTERED, REGISTERED
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  qrTokens                QrToken[]
  attendances             Attendance[]
}

model Event {
  id               String       @id @default(uuid())
  slug             String       @unique // e.g. "attendance"
  name             String
  description      String?
  isActive         Boolean      @default(true)
  requiresPayment  Boolean      @default(false) // false = entrance (all), true = kit allocation (paid only)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  qrTokens         QrToken[]
  attendances      Attendance[]
}

model QrToken {
  id          String       @id @default(uuid())
  candidateId String
  eventId     String
  token       String       @unique
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@unique([candidateId, eventId])
}

model Attendance {
  id          String    @id @default(uuid())
  candidateId String
  eventId     String
  qrTokenId   String
  entryTime   DateTime  @default(now())
  status      String    @default("SUCCESS")
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  qrToken     QrToken   @relation(fields: [qrTokenId], references: [id], onDelete: Cascade)

  // Mandatory DB-level unique constraint preventing duplicate entries
  @@unique([candidateId, eventId])
}

model ImportLog {
  id                  String   @id @default(uuid())
  filename            String
  totalRows           Int
  newCandidates       Int
  updatedCandidates   Int
  unchangedCandidates Int
  rejectedRows        Int
  createdAt           DateTime @default(now())
}
